# ==============================================================================
# Smart Traffic Coordination System — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server Configuration
# ------------------------------------------------------------------------------
# Network interface to bind the FastAPI/Uvicorn server (127.0.0.1 for local dev, 0.0.0.0 for Docker)
HOST=127.0.0.1
# Port to listen on
PORT=8000
# Debug mode: enables verbose logging and auto-reload (set to false in production)
DEBUG=false
# Application log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Enable structured console logging (JSON / formatted timestamped)
STRUCTURED_LOGGING=true

# ------------------------------------------------------------------------------
# 2. Eclipse SUMO & Microscopic Simulation Configuration
# ------------------------------------------------------------------------------
# Optional: Explicit path to Eclipse SUMO installation root.
# If omitted, the system auto-discovers SUMO from PATH or standard OS locations:
#   Windows: C:\Program Files (x86)\Eclipse\Sumo or C:\Program Files\Eclipse\Sumo
#   Linux:   /usr/share/sumo
#   macOS:   /opt/homebrew/opt/sumo/share/sumo
# SUMO_HOME=C:\Program Files (x86)\Eclipse\Sumo

# Relative path to the corridor SUMO configuration file
SUMO_CONFIG_PATH=sumo/silk_board/silk_board.sumocfg

# Launch SUMO GUI window instead of headless binary (requires local X11 / display server)
SUMO_GUI=false

# Microscopic simulation discrete step length in seconds (authoritative: 1.0s)
SUMO_STEP_LENGTH=1.0

# ------------------------------------------------------------------------------
# 3. Database & Persistence Configuration
# ------------------------------------------------------------------------------
# SQLAlchemy database connection string. Defaults to SQLite in workspace root.
DATABASE_URL=sqlite:///./traffic_dashboard.db

# ------------------------------------------------------------------------------
# 4. Security & Network Isolation
# ------------------------------------------------------------------------------
# Comma-separated list of allowed HTTP/WebSocket origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Enable standard HTTP security headers (X-Content-Type-Options, X-Frame-Options, etc.)
ENABLE_SECURITY_HEADERS=true
